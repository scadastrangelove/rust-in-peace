{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-agent evidence v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "ai-agent"
    },
    "scenario_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configuration": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "image",
        "configuration",
        "source_commit",
        "platform"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "mechanism",
        "agent_behavior"
      ]
    },
    "scope": {
      "enum": [
        "static_path",
        "component",
        "shipping_entrypoint",
        "full_chain"
      ]
    },
    "oracle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "invariant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "collector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "name",
        "version",
        "boundary"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "trial_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "value_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "matched": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "value": {}
        },
        "required": [
          "id",
          "trial_id",
          "source",
          "kind",
          "value_digest",
          "matched",
          "detail",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "trial_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "trial_id",
          "kind",
          "passed",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "status": {
            "enum": [
              "completed",
              "infrastructure_error",
              "unsupported",
              "budget_exhausted"
            ]
          },
          "violation": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 1024
          },
          "model": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "settings": {
                "type": "object"
              },
              "endpoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "provider",
              "model",
              "revision",
              "settings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "status",
          "violation",
          "duration_ms",
          "error",
          "observation_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "scheduled_trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "discovery_attempts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "state": {
            "enum": [
              "not_present",
              "not_observed",
              "not_tested",
              "blocked_by_control",
              "partial"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "surface",
          "state",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "profile",
    "scenario_digest",
    "contract_digest",
    "artifact",
    "mode",
    "scope",
    "oracle",
    "invariant",
    "collector",
    "observations",
    "controls",
    "trials",
    "scheduled_trials",
    "discovery_attempts",
    "coverage",
    "notes"
  ],
  "additionalProperties": false
}
