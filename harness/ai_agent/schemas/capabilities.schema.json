{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-agent capabilities v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "ai-agent"
    },
    "artifact": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configuration": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "present",
                  "absent",
                  "partial",
                  "unknown"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "minItems": 0,
                "maxItems": 64
              },
              "collector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "state",
              "scope",
              "evidence",
              "collector"
            ],
            "additionalProperties": false
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "present",
                    "absent"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minProperties": 0,
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    }
  },
  "required": [
    "schema_version",
    "profile",
    "artifact",
    "configuration",
    "capabilities"
  ],
  "additionalProperties": false
}
